# API configuration
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Neon PostgreSQL connection string (copy from Neon Console -> Project -> Connect).
# Use the pooled connection string for the application. Keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate a long random value for local development and production.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional AI provider configuration (keep secrets server-side)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
