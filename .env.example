# API configuration
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Neon PostgreSQL connection string (use the pooled endpoint and sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate a random secret with at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# One-time first-run superadmin bootstrap. Remove these after creating the superadmin.
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=replace-with-a-strong-one-time-password

# OpenAI-compatible AI provider. Keep all keys on the API server, never in Vite variables.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_STT_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=nova
